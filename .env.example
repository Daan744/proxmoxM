# Shared
POSTGRES_DB=proxmox_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/proxmox_portal?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Backend
BACKEND_PORT=3001
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
COOKIE_SECURE=false
API_RATE_LIMIT_TTL_SEC=60
API_RATE_LIMIT_MAX=120
REQUEST_BODY_LIMIT=1mb
ALLOW_USER_PROVISIONING=true
APPLY_QUOTA_TO_ADMIN=false
MIN_FREE_DISK_GB=20
MAX_CPU_PCT_FOR_AUTO=90
MAX_MEM_PCT_FOR_AUTO=90
PROXMOX_HOST=pve1.example.local
PROXMOX_TOKEN_ID=root@pam!portal
PROXMOX_TOKEN_SECRET=replace_me
PROXMOX_TLS_INSECURE=true
PROXMOX_DEFAULT_BRIDGE=vmbr0
PROXMOX_SYNC_EVERY_MS=120000
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=Admin123!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
